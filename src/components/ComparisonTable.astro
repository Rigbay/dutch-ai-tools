---
import AffiliateLink from './AffiliateLink.astro';
import { detectMerchant, merchantMatchesTool } from '../lib/affiliateRegistry';

interface Tool { name: string; verdict: string; priceRange: string; bestFor: string; rating: number; affiliateLink: string; }
interface Props { tools: Tool[]; }
const { tools } = Astro.props;
const isSponsoredLink = (url: string) => /[?&](via|ref|tag|fp_ref|pc)=/i.test(url) || url.includes('pxf.io/');
const linkRel = (url: string) => isSponsoredLink(url) ? 'nofollow sponsored' : 'nofollow';
const initials = (name: string) => name.split(/\s+/).map((part) => part[0]).join('').slice(0, 3).toUpperCase();
---

<div class="grid gap-3 md:hidden">
  {tools.map((tool, index) => {
    const merchantId = detectMerchant(tool.affiliateLink);
    const affiliateMerchantId = merchantId && merchantMatchesTool(merchantId, tool.name) ? merchantId : null;
    return (
      <article class="rounded-2xl border border-[#dfe5ec] bg-white p-5">
        <div class="flex items-start gap-3"><span class="tool-orb">{initials(tool.name)}</span><div class="min-w-0 flex-1"><div class="flex items-start justify-between gap-3"><h3 class="font-extrabold text-ink">{tool.name}</h3><span class="shrink-0 text-sm font-extrabold text-[#118c7a]">{tool.rating.toFixed(1)}/5</span></div><p class="mt-1 text-xs font-bold uppercase tracking-[.11em] text-leaf">{index === 0 ? 'Onze allround keuze' : tool.bestFor}</p></div></div>
        <p class="mt-4 text-sm leading-6 text-muted">{tool.verdict}</p>
        <div class="mt-4 flex items-center justify-between gap-3 border-t border-[#edf0f4] pt-4"><span class="text-sm font-bold text-ink">{tool.priceRange}</span>{affiliateMerchantId ? <AffiliateLink merchantId={affiliateMerchantId} siteId="dutch-ai-tools" class="button-primary min-h-0 px-3 py-2 text-xs">Naar aanbieder</AffiliateLink> : !merchantId ? <a class="button-primary min-h-0 px-3 py-2 text-xs" href={tool.affiliateLink} rel={linkRel(tool.affiliateLink)}>Naar aanbieder</a> : null}</div>
      </article>
    );
  })}
</div>

<div class="hidden overflow-hidden rounded-2xl border border-[#dfe5ec] bg-white md:block">
  <table class="w-full border-collapse text-left text-sm">
    <thead class="bg-[#f1f5fa] text-ink"><tr><th class="px-5 py-4">Tool</th><th class="px-4 py-4">Beste voor</th><th class="px-4 py-4">Prijs</th><th class="px-4 py-4">Oordeel</th><th class="px-4 py-4"><span class="sr-only">Aanbieder</span></th></tr></thead>
    <tbody>
      {tools.map((tool, index) => {
        const merchantId = detectMerchant(tool.affiliateLink);
        const affiliateMerchantId = merchantId && merchantMatchesTool(merchantId, tool.name) ? merchantId : null;
        return (
          <tr class="border-t border-[#e7ebf0] align-middle">
            <td class="px-5 py-4"><div class="flex items-center gap-3"><span class="tool-orb h-9 w-9 text-[.68rem]">{initials(tool.name)}</span><div><strong class="block text-ink">{tool.name}</strong>{index === 0 && <span class="text-[.65rem] font-extrabold uppercase tracking-[.12em] text-leaf">Allround keuze</span>}</div></div></td>
            <td class="max-w-[11rem] px-4 py-4 font-semibold text-muted">{tool.bestFor}</td>
            <td class="max-w-[9rem] px-4 py-4 text-muted">{tool.priceRange}</td>
            <td class="max-w-[17rem] px-4 py-4"><span class="font-extrabold text-[#118c7a]">{tool.rating.toFixed(1)}</span><span class="ml-2 text-muted">{tool.verdict}</span></td>
            <td class="px-4 py-4">{affiliateMerchantId ? <AffiliateLink merchantId={affiliateMerchantId} siteId="dutch-ai-tools" class="button-secondary min-h-0 whitespace-nowrap px-3 py-2 text-xs">Bekijk →</AffiliateLink> : !merchantId ? <a class="button-secondary min-h-0 whitespace-nowrap px-3 py-2 text-xs" href={tool.affiliateLink} rel={linkRel(tool.affiliateLink)}>Bekijk →</a> : null}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
