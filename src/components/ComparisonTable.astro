---
import AffiliateLink from './AffiliateLink.astro';
import { canRenderAffiliate, detectMerchant, merchantMatchesTool, resolveSafeDirectProviderUrl } from '../lib/affiliateRegistry';

interface Tool { name: string; verdict: string; priceRange: string; bestFor: string; rating: number; affiliateLink: string; }
interface Props { tools: Tool[]; }
const { tools } = Astro.props;
---

<div class="grid grid-cols-1 gap-3 md:hidden">
  {tools.map((tool, index) => {
    const merchantId = detectMerchant(tool.affiliateLink);
    const merchantMatches = !!merchantId && merchantMatchesTool(merchantId, tool.name);
    const affiliateMerchantId = merchantId && merchantMatches && canRenderAffiliate(merchantId, 'dutch-ai-tools') ? merchantId : null;
    const directProviderUrl = !merchantId || merchantMatches ? resolveSafeDirectProviderUrl(tool.affiliateLink) : null;
    return (
      <article class="border-b border-[#d3dce6] bg-white py-5">
        <div class="flex items-start justify-between gap-4"><div class="min-w-0"><h3 class="text-lg font-bold text-ink">{tool.name}</h3><p class="mt-1 text-sm text-muted">Toepassing: {tool.bestFor}</p></div><span class="shrink-0 text-sm text-muted" aria-label={`Redactionele score ${tool.rating.toFixed(1)} van 5`}>{tool.rating.toFixed(1)}/5</span></div>
        <p class="mt-3 text-base leading-7 text-muted">{tool.verdict}</p>
        <div class="mt-4 flex flex-wrap items-center justify-between gap-3"><span class="text-sm text-ink">Prijs: {tool.priceRange}</span>{affiliateMerchantId ? <AffiliateLink merchantId={affiliateMerchantId} siteId="dutch-ai-tools" class="button-secondary">Naar aanbieder · partnerlink</AffiliateLink> : directProviderUrl ? <a class="button-secondary" href={directProviderUrl} rel="nofollow">Naar aanbieder</a> : null}</div>
      </article>
    );
  })}
</div>

<div class="hidden overflow-x-auto bg-white md:block" tabindex="0" role="region" aria-label="Tools vergelijken, horizontaal scrollbaar">
  <table class="w-full border-collapse text-left text-base">
    <caption class="sr-only">Toepassing, prijsindicatie en redactioneel oordeel per tool</caption>
    <thead class="bg-[#f1f5fa] text-ink"><tr><th scope="col" class="px-5 py-4">Tool</th><th scope="col" class="px-4 py-4">Toepassing</th><th scope="col" class="px-4 py-4">Prijsindicatie</th><th scope="col" class="px-4 py-4">Redactioneel oordeel</th><th scope="col" class="px-4 py-4">Aanbieder</th></tr></thead>
    <tbody>
      {tools.map((tool, index) => {
        const merchantId = detectMerchant(tool.affiliateLink);
        const merchantMatches = !!merchantId && merchantMatchesTool(merchantId, tool.name);
        const affiliateMerchantId = merchantId && merchantMatches && canRenderAffiliate(merchantId, 'dutch-ai-tools') ? merchantId : null;
        const directProviderUrl = !merchantId || merchantMatches ? resolveSafeDirectProviderUrl(tool.affiliateLink) : null;
        return (
          <tr class="border-t border-[#e7ebf0] align-middle">
            <th scope="row" class="px-5 py-4 font-bold text-ink">{tool.name}</th>
            <td class="max-w-[11rem] px-4 py-4 font-semibold text-muted">{tool.bestFor}</td>
            <td class="max-w-[9rem] px-4 py-4 text-muted">{tool.priceRange}</td>
            <td class="max-w-[17rem] px-4 py-4"><span class="text-sm text-muted">{tool.rating.toFixed(1)}/5</span><span class="mt-1 block text-muted">{tool.verdict}</span></td>
            <td class="px-4 py-4">{affiliateMerchantId ? <AffiliateLink merchantId={affiliateMerchantId} siteId="dutch-ai-tools" class="button-secondary">Naar aanbieder · partnerlink</AffiliateLink> : directProviderUrl ? <a class="button-secondary" href={directProviderUrl} rel="nofollow">Naar aanbieder</a> : null}</td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
