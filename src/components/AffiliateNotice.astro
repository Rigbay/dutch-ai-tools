---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---

<aside class:list={[
  compact
    ? 'rounded-xl border border-[#dfe5ec] bg-white/80 px-3.5 py-2.5 text-xs text-[#53606d] shadow-sm'
    : 'rounded-2xl border border-[#d6e7e2] bg-[#f0faf7] px-5 py-4 text-sm text-[#264d45]'
]}>
  <p class:list={[compact ? 'leading-5' : 'leading-6']}><strong class="font-extrabold text-[#173f3a]">Advertentie-informatie.</strong> Sommige knoppen zijn partnerlinks. Als je via zo’n link iets afsluit, kunnen wij commissie ontvangen; jij betaalt niet extra. Dit verandert onze rangschikking niet.</p>
</aside>
