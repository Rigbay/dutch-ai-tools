---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<aside class:list={[
  'rounded border border-[#e0d8f0] bg-[#faf5ff] text-[#5b3a8e]',
  compact ? 'px-4 py-3 text-sm' : 'px-5 py-4 text-base'
]}>
  <p class="font-bold">Affiliate disclaimer</p>
  <p class="mt-1">
    Sommige links op deze pagina zijn affiliate links. Als je via zo'n link een abonnement afsluit, kan deze site een commissie ontvangen. Jij betaalt daardoor niet extra. De rangschikking blijft gebaseerd op functionaliteit, prijs en gebruikerservaringen.
  </p>
</aside>
