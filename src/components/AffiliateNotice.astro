---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
---

<aside class:list={[
  compact
    ? 'border-l-2 border-[#536474] bg-[#f3f6fa] px-4 py-3 text-sm text-[#53606d]'
    : 'border-l-2 border-[#536474] bg-[#f3f6fa] px-5 py-4 text-sm text-[#53606d]'
]}>
  <p class="leading-6"><strong class="font-bold text-ink">Advertentie-informatie.</strong> Sommige knoppen zijn partnerlinks. Als je via zo’n link iets afsluit, kunnen wij commissie ontvangen; jij betaalt niet extra. Dit verandert onze rangschikking niet.</p>
</aside>
