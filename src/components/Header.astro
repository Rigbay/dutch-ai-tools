---
const navItems = [
  { href: '/vergelijkingen-2026/', label: 'Keuzehulpen' },
  { href: '/vergelijk/', label: '1-op-1 vergelijken' },
  { href: '/categorie/productiviteit/', label: 'Productiviteit' },
  { href: '/categorie/creatie/', label: 'Creatie' },
  { href: '/over/', label: 'Werkwijze' },
];
---

<header class="site-header">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-5 px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="group inline-flex min-w-0 items-center gap-3 text-ink" aria-label="Dutch AI Tools home">
      <span class="brand-mark" aria-hidden="true"><span>AI</span></span>
      <span class="min-w-0">
        <span class="block truncate text-[1.05rem] font-extrabold leading-none tracking-[-0.02em]">Dutch AI Tools</span>
        <span class="mt-1 block truncate text-[0.65rem] font-bold uppercase tracking-[0.18em] text-muted">Kies wijzer. Werk slimmer.</span>
      </span>
    </a>

    <nav class="hidden lg:block" aria-label="Hoofdnavigatie">
      <ul class="flex items-center gap-1 text-sm font-semibold text-muted">
        {navItems.map((item) => (
          <li><a class="nav-link" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <details class="mobile-menu relative lg:hidden">
      <summary class="menu-button" aria-label="Open menu">
        <span>Menu</span><span class="menu-lines" aria-hidden="true"></span>
      </summary>
      <nav class="mobile-menu-panel" aria-label="Mobiele navigatie">
        <ul class="grid gap-1">
          {navItems.map((item) => (
            <li><a href={item.href}>{item.label}<span aria-hidden="true">↗</span></a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>
