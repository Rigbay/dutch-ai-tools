---
import type { CollectionEntry } from 'astro:content';

interface Props { article: CollectionEntry<'articles'>; }
const { article } = Astro.props;
const data = article.data || {};
const slug = data.slug || article.id || '';
const categoryLabel: Record<string, string> = {
  productiviteit: 'Productiviteit', marketing: 'Marketing', creatie: 'Creatie',
  development: 'Development', business: 'Business', technologie: 'Technologie',
  'huis-tuin': 'Huis & Tuin', persoonlijk: 'Persoonlijk'
};
const initials = (data.featuredTool || 'AI').split(/\s+/).map((part: string) => part[0]).join('').slice(0, 3).toUpperCase();
---

<article class="group flex h-full flex-col overflow-hidden rounded-2xl border border-[#dfe5ec] bg-white transition hover:-translate-y-1 hover:border-[#c6d2df] hover:shadow-soft">
  <div class="flex items-center justify-between border-b border-[#edf0f4] bg-[#f8fafc] px-5 py-4">
    <div class="flex min-w-0 items-center gap-3"><span class="tool-orb h-9 w-9 rounded-xl text-[.68rem]">{initials}</span><span class="truncate text-xs font-extrabold uppercase tracking-[.13em] text-muted">{categoryLabel[data.category] || data.category}</span></div>
    <span class="text-xs font-bold text-muted">{data.readingTime}</span>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h2 class="text-xl font-extrabold leading-tight tracking-[-.03em] text-ink sm:text-[1.35rem]"><a href={`/${slug}/`} class="transition group-hover:text-leaf">{data.title || slug}</a></h2>
    <p class="mt-3 line-clamp-3 flex-1 text-sm leading-6 text-muted">{data.description || ''}</p>
    <div class="mt-6 flex items-center justify-between gap-3 border-t border-[#edf0f4] pt-4 text-sm">
      <div><span class="font-extrabold text-ink">{data.featuredTool}</span><span class="ml-2 text-xs font-bold text-[#118c7a]">{data.rating ? data.rating.toFixed(1) : '—'}/5</span></div>
      <span class="font-extrabold text-leaf transition group-hover:translate-x-1" aria-hidden="true">→</span>
    </div>
  </div>
</article>
