---
interface Props {
  name: 'writing' | 'research' | 'building';
}

const { name } = Astro.props;
---

<svg
  class="h-5 w-5"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'writing' && (
    <>
      <path d="M5.5 3.75h8l5 5v11.5H5.5z" />
      <path d="M13.5 3.75v5h5" />
      <path d="M8.5 13h7M8.5 16.5h4.5" />
    </>
  )}
  {name === 'research' && (
    <>
      <circle cx="10.5" cy="10.5" r="5.75" />
      <path d="m14.75 14.75 4.5 4.5M8.5 8.75h4M8.5 11.25h2.75" />
    </>
  )}
  {name === 'building' && (
    <>
      <path d="m8.75 7-4 5 4 5M15.25 7l4 5-4 5M13 4.75l-2 14.5" />
    </>
  )}
</svg>
