---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogType?: string;
}

const {
  title,
  description,
  canonicalUrl,
  ogType = 'website'
} = Astro.props;

const origin = Astro.site ?? new URL('https://dutchaitools.nl');
const basePath = import.meta.env.BASE_URL;
const site = new URL(basePath, origin);
const assetPath = (path: string) => `${basePath.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, site).toString();
const ogImage = new URL(assetPath('/og-default.svg'), origin).toString();
const faviconPath = assetPath('/favicon.svg');

const orgSchema = {
  '@context': 'https://schema.org',
  '@id': site.toString() + '#organization',
  '@type': 'Organization',
  'name': 'Dutch AI Tools',
  'url': site.toString(),
  'description': 'Onafhankelijke Nederlandstalige keuzehulpen voor AI-tools, met duidelijke use-cases, beperkingen en bronverwijzingen.',
  'logo': new URL(faviconPath, origin).toString()
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@id': site.toString() + '#website',
  '@type': 'WebSite',
  'url': site.toString(),
  'name': 'Dutch AI Tools',
  'description': 'Nederlandstalige keuzehulpen voor AI-tools',
  'inLanguage': 'nl-NL',
  'about': {
    '@type': 'Organization',
    '@id': site.toString() + '#organization'
  }
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={faviconPath} type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-P1DQLR76C6"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-P1DQLR76C6');

      document.addEventListener('click', function (event) {
        var target = event.target;
        if (!(target instanceof Element)) return;

        var link = target.closest('a[data-affiliate-merchant]');
        if (!(link instanceof HTMLAnchorElement) || typeof window.gtag !== 'function') return;

        var destination = new URL(link.href, window.location.href);
        window.gtag('event', 'affiliate_outbound_click', {
          affiliate_merchant: link.dataset.affiliateMerchant || 'unknown',
          affiliate_site: link.dataset.affiliateSite || 'dutch-ai-tools',
          link_domain: destination.hostname,
          link_url: destination.href,
          page_location: window.location.href,
          transport_type: 'beacon'
        });
      });
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
