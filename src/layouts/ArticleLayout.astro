---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import AffiliateNotice from '../components/AffiliateNotice.astro';
import AffiliateLink from '../components/AffiliateLink.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import { detectMerchant, merchantMatchesTool } from '../lib/affiliateRegistry';

interface Props { article: CollectionEntry<'articles'>; relatedArticles: CollectionEntry<'articles'>[]; }
const { article, relatedArticles } = Astro.props;
const data = article.data;
const site = new URL('https://dutchaitools.nl');
const canonical = new URL(`/${data.slug}/`, site).toString();
const categoryLabel: Record<string, string> = {
  productiviteit: 'Productiviteit', marketing: 'Marketing', creatie: 'Creatie', development: 'Development',
  business: 'Business', technologie: 'Technologie', 'huis-tuin': 'Huis & Tuin', persoonlijk: 'Persoonlijk'
};
const bestTool = data.tools.find((tool) => tool.name === data.featuredTool) || data.tools[0];
const bestMerchantId = detectMerchant(bestTool.affiliateLink);
const bestMerchantMatches = !!bestMerchantId && merchantMatchesTool(bestMerchantId, bestTool.name);
const isSponsoredLink = (url: string) => /[?&](via|ref|tag|fp_ref|pc)=/i.test(url) || url.includes('pxf.io/');
const linkRel = (url: string) => isSponsoredLink(url) ? 'nofollow sponsored' : 'nofollow';
const initials = bestTool.name.split(/\s+/).map((part) => part[0]).join('').slice(0, 3).toUpperCase();

const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site.toString() },
  { '@type': 'ListItem', position: 2, name: categoryLabel[data.category] || data.category, item: new URL(`/categorie/${data.category}/`, site).toString() },
  { '@type': 'ListItem', position: 3, name: data.title, item: canonical }
]};
const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', '@id': canonical + '#article', headline: data.title, description: data.description,
  datePublished: data.date.toISOString().split('T')[0], dateModified: data.date.toISOString().split('T')[0],
  author: { '@type': 'Organization', name: 'Dutch AI Tools', '@id': site.toString() + '#organization' },
  publisher: { '@type': 'Organization', name: 'Dutch AI Tools', '@id': site.toString() + '#organization' },
  inLanguage: 'nl-NL', mainEntityOfPage: { '@type': 'WebPage', '@id': canonical }
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: data.faq.map((item: { q: string; a: string }) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) };
---

<BaseLayout title={`${data.title} | Dutch AI Tools`} description={data.description} canonicalUrl={canonical} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <article>
    <header class="relative overflow-hidden border-b border-[#dfe5ec]">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_82%_24%,rgba(35,87,223,.1),transparent_24rem)]"></div>
      <div class="relative mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-16 lg:px-8">
        <nav aria-label="Kruimelpad" class="flex flex-wrap items-center gap-2 text-xs font-bold text-muted"><a class="hover:text-leaf" href="/">Home</a><span aria-hidden="true">/</span><a class="hover:text-leaf" href={`/categorie/${data.category}/`}>{categoryLabel[data.category] || data.category}</a><span aria-hidden="true">/</span><span class="text-ink">Keuzehulp {data.modelYear}</span></nav>
        <div class="mt-8 grid gap-8 lg:grid-cols-[1.35fr_.65fr] lg:items-end">
          <div>
            <p class="eyebrow">{categoryLabel[data.category] || data.category} · onafhankelijk vergeleken</p>
            <h1 class="mt-4 max-w-4xl text-[clamp(2.4rem,7vw,4.8rem)] font-extrabold leading-[.98] tracking-[-.055em] text-ink">{data.title}</h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-muted">{data.description}</p>
            <div class="mt-7 flex flex-wrap gap-x-6 gap-y-3 text-xs font-bold text-muted">
              <span>Update <time datetime={data.date.toISOString()}>{data.date.toLocaleDateString('nl-NL', { year: 'numeric', month: 'long', day: 'numeric' })}</time></span>
              <span>{data.readingTime} leestijd</span><span>{data.tools.length} tools vergeleken</span>
            </div>
          </div>

          <aside class="premium-card overflow-hidden">
            <div class="bg-[linear-gradient(145deg,#173da7,#2357df_60%,#22b69b)] p-5 text-white sm:p-6">
              <div class="flex items-center justify-between gap-3"><span class="text-xs font-extrabold uppercase tracking-[.16em] text-white/75">Beste allround keuze</span><span class="rounded-full bg-white/15 px-2.5 py-1 text-xs font-extrabold">{bestTool.rating.toFixed(1)}/5</span></div>
              <div class="mt-5 flex items-center gap-4"><span class="grid h-12 w-12 place-items-center rounded-2xl border border-white/25 bg-white/10 text-sm font-black">{initials}</span><h2 class="text-2xl font-extrabold tracking-[-.035em]">{bestTool.name}</h2></div>
            </div>
            <div class="p-5 sm:p-6"><p class="text-sm leading-6 text-muted">{bestTool.verdict}</p><p class="mt-3 text-xs font-bold uppercase tracking-[.12em] text-leaf">Beste voor: {bestTool.bestFor}</p>
              {bestMerchantId && bestMerchantMatches ? <div class="mt-5"><AffiliateLink merchantId={bestMerchantId} siteId="dutch-ai-tools" class="button-primary w-full">Naar {bestTool.name} <span class="ml-2" aria-hidden="true">→</span></AffiliateLink></div> : !bestMerchantId ? <a class="button-primary mt-5 w-full" href={bestTool.affiliateLink} rel={linkRel(bestTool.affiliateLink)}>Naar {bestTool.name} <span class="ml-2" aria-hidden="true">→</span></a> : null}
            </div>
          </aside>
        </div>
      </div>
    </header>

    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
      <section class="grid gap-4 md:grid-cols-2">
        <div class="rounded-2xl border border-[#d6e7e2] bg-[#f0faf7] p-5 sm:p-6"><p class="text-xs font-extrabold uppercase tracking-[.15em] text-[#118c7a]">Wanneer dit helpt</p><h2 class="mt-2 text-2xl font-extrabold tracking-[-.035em] text-ink">Sterke kanten</h2><ul class="mt-4 space-y-3 text-sm leading-6 text-muted">{data.pros.map((item) => <li class="flex gap-3"><span class="font-black text-[#118c7a]">✓</span><span>{item}</span></li>)}</ul></div>
        <div class="rounded-2xl border border-[#eadedb] bg-[#fff8f6] p-5 sm:p-6"><p class="text-xs font-extrabold uppercase tracking-[.15em] text-clay">Wanneer je moet opletten</p><h2 class="mt-2 text-2xl font-extrabold tracking-[-.035em] text-ink">Beperkingen</h2><ul class="mt-4 space-y-3 text-sm leading-6 text-muted">{data.cons.map((item) => <li class="flex gap-3"><span class="font-black text-clay">!</span><span>{item}</span></li>)}</ul></div>
      </section>

      <section class="mt-12 sm:mt-16">
        <div class="max-w-3xl"><p class="eyebrow">De shortlist</p><h2 class="section-title mt-3">Vergelijk op de verschillen die tellen.</h2><p class="mt-4 leading-7 text-muted">Scores zijn redactionele wegwijzers, geen laboratoriumuitslag. Gebruik vooral ‘beste voor’, beperkingen en de officiële productlink om je keuze te controleren.</p></div>
        <div class="mt-7"><ComparisonTable tools={data.tools} /></div>
      </section>

      <div class="mt-8"><AffiliateNotice compact /></div>

      <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_15rem] lg:items-start">
        <div class="prose-article min-w-0 max-w-3xl"><slot /></div>
        <aside class="hidden lg:sticky lg:top-28 lg:block"><div class="rounded-2xl border border-[#dfe5ec] bg-[#f8fafc] p-5"><p class="text-xs font-extrabold uppercase tracking-[.14em] text-leaf">Leeswijzer</p><ul class="mt-4 space-y-3 text-sm font-bold text-muted"><li><a class="hover:text-leaf" href="#advies-per-situatie">Advies per situatie</a></li><li><a class="hover:text-leaf" href="#tool-voor-tool">Tool voor tool</a></li><li><a class="hover:text-leaf" href="#zo-maak-je-de-keuze">Zo maak je de keuze</a></li><li><a class="hover:text-leaf" href="#bronnen">Bronnen</a></li></ul></div></aside>
      </div>

      <section class="mt-16"><div class="max-w-2xl"><p class="eyebrow">Nog onduidelijk?</p><h2 class="section-title mt-3">Veelgestelde vragen</h2></div><div class="mt-6 grid gap-3 md:grid-cols-2">{data.faq.map((item: { q: string; a: string }) => <details class="rounded-2xl border border-[#dfe5ec] bg-white p-5 open:border-[#b9c9ef]"><summary class="cursor-pointer pr-4 font-extrabold leading-6 text-ink hover:text-leaf">{item.q}</summary><p class="mt-3 text-sm leading-6 text-muted">{item.a}</p></details>)}</div></section>

      {relatedArticles.length > 0 && <section class="mt-16"><p class="eyebrow">Verder kiezen</p><h2 class="section-title mt-3">Gerelateerde keuzehulpen</h2><div class="mt-7 grid gap-5 md:grid-cols-3">{relatedArticles.map((related) => <ArticleCard article={related} />)}</div></section>}
    </div>
  </article>
</BaseLayout>
