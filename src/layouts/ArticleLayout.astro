---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import AffiliateNotice from '../components/AffiliateNotice.astro';
import AffiliateLink from '../components/AffiliateLink.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import { canRenderAffiliate, detectMerchant, hasAffiliateTrackingSignal, merchantMatchesTool } from '../lib/affiliateRegistry';

interface Props { article: CollectionEntry<'articles'>; relatedArticles: CollectionEntry<'articles'>[]; headings?: MarkdownHeading[]; }
const { article, relatedArticles, headings = [] } = Astro.props;
const data = article.data;
const isAutomationJourney = data.slug === 'beste-ai-automation-tools-2026';
const sections = headings.filter((heading) => heading.depth === 2 && heading.slug && heading.text.trim());
const unusedId = (base: string) => {
  let id = base;
  while (headings.some(heading => heading.slug === id)) id = `dat-${id}`;
  return id;
};
const providersId = unusedId('aanbieders');
const faqId = unusedId('vragen-en-antwoorden');
// The first article section contains the four situations; use rendered slugs, not guessed anchors.
const situationStart = headings.findIndex((heading) => heading.depth === 2);
const situationEnd = headings.findIndex((heading, index) => index > situationStart && heading.depth === 2);
const situations = headings.slice(situationStart + 1, situationEnd < 0 ? undefined : situationEnd)
  .filter((heading) => heading.depth === 3);
const site = new URL('https://dutchaitools.nl');
const canonical = new URL(`/${data.slug}/`, site).toString();
const categoryLabel: Record<string, string> = {
  productiviteit: 'Productiviteit', marketing: 'Marketing', creatie: 'Creatie', development: 'Development',
  business: 'Business', technologie: 'Technologie', 'huis-tuin': 'Huis & Tuin', persoonlijk: 'Persoonlijk'
};
const hasRenderedStructuredAffiliate = data.tools.some((tool) => {
  const merchantId = detectMerchant(tool.affiliateLink);
  return !!merchantId && merchantMatchesTool(merchantId, tool.name) && canRenderAffiliate(merchantId, 'dutch-ai-tools');
});
const bodyUrls = article.body.match(/https?:\/\/[^\s)"'<]+/g) || [];
const hasRenderedBodyAffiliate = bodyUrls.some((url) => {
  const merchantId = detectMerchant(url);
  return !!merchantId && hasAffiliateTrackingSignal(url) && canRenderAffiliate(merchantId, 'dutch-ai-tools');
});
const hasRenderedAffiliate = hasRenderedStructuredAffiliate || hasRenderedBodyAffiliate;

const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: site.toString() },
  { '@type': 'ListItem', position: 2, name: categoryLabel[data.category] || data.category, item: new URL(`/categorie/${data.category}/`, site).toString() },
  { '@type': 'ListItem', position: 3, name: data.title, item: canonical }
]};
const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', '@id': canonical + '#article', headline: data.title, description: data.description,
  datePublished: data.date.toISOString().split('T')[0], dateModified: data.date.toISOString().split('T')[0],
  author: { '@type': 'Organization', name: 'Dutch AI Tools', '@id': site.toString() + '#organization' },
  publisher: { '@type': 'Organization', name: 'Dutch AI Tools', '@id': site.toString() + '#organization' },
  inLanguage: 'nl-NL', mainEntityOfPage: { '@type': 'WebPage', '@id': canonical }
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: data.faq.map((item: { q: string; a: string }) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) };
---

<BaseLayout title={`${data.title} | Dutch AI Tools`} description={data.description} canonicalUrl={canonical} ogType="article">
 <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
 <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
 <article class="page-width">
  <header class="article-heading">
   <nav aria-label="Kruimelpad" class="flex flex-wrap gap-2 text-sm text-muted"><a class="underline" href="/">Home</a><span aria-hidden="true">/</span><a class="underline" href={`/categorie/${data.category}/`}>{categoryLabel[data.category] || data.category}</a></nav>
   <h1>{data.title}</h1>
   <p class="description">{isAutomationJourney ? 'Begin bij het proces dat je wilt automatiseren. Vergelijk daarna hoeveel technische controle, beheer en gebruik het vraagt — en test dezelfde workflow voordat je kiest.' : data.description}</p>
   <div class="article-meta"><span>Artikel bijgewerkt: <time datetime={data.date.toISOString()}>{data.date.toLocaleDateString('nl-NL',{year:'numeric',month:'long',day:'numeric'})}</time></span><span>{data.readingTime} leestijd</span><span>{data.tools.length} tools</span><a class="underline" href="/over/">Werkwijze</a></div>
   {hasRenderedAffiliate && <div class="mt-5"><AffiliateNotice compact /></div>}
  </header>
  {isAutomationJourney && <nav aria-label="Kies je situatie" class="article-section"><h2 class="text-lg font-bold">Wat wil je bouwen?</h2><ul class="mt-3 grid gap-x-8 md:grid-cols-2">{situations.map(heading => <li><a class="block py-2 text-leaf underline" href={`#${heading.slug}`}>{heading.text}</a></li>)}</ul></nav>}
  <div class="article-columns">
   <nav class="article-toc" aria-label="Op deze pagina"><details open data-collapse-phone><summary>In dit artikel</summary><ul>{sections.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}<li><a href={`#${providersId}`}>Aanbieders en samenvatting</a></li><li><a href={`#${faqId}`}>Veelgestelde vragen</a></li></ul></details></nav>
   <div class="prose-article"><slot /></div>
  </div>
  <section class="article-section" aria-labelledby={providersId}><h2 id={providersId} class="section-title">Aanbieders en samenvatting</h2><p>De prijzen en oordelen hieronder horen bij de artikeldatum. Controleer de actuele voorwaarden bij de aanbieder. <a class="text-leaf underline" href="/over/#scores">Over de scores</a></p><div class="mt-6"><ComparisonTable tools={data.tools} /></div></section>
  <section class="article-section" aria-labelledby={faqId}><h2 id={faqId} class="section-title">Veelgestelde vragen</h2><div class="faq-list">{data.faq.map(item => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></section>
  {relatedArticles.length > 0 && <section class="article-section"><h2 class="section-title">Verder lezen</h2><div class="grid gap-x-8 md:grid-cols-3">{relatedArticles.map(related => <ArticleCard article={related} />)}</div></section>}
 </article>
</BaseLayout>
