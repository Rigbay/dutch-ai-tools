---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleSearch from '../../components/ArticleSearch.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  const categories = [...new Set(articles.map((article) => article.data.category))].sort();
  return categories.map((cat) => ({ params: { cat } }));
}

const { cat } = Astro.params;

const articles = (await getCollection('articles', ({ data }) => !data.draft && data.category === cat))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const labels: Record<string, string> = {
  productiviteit: 'Productiviteit',
  marketing: 'Marketing',
  creatie: 'Creatie',
  development: 'Development',
  business: 'Business',
  technologie: 'Technologie',
  'huis-tuin': 'Huis & Tuin',
  persoonlijk: 'Persoonlijk'
};

const descriptions: Record<string, string> = {
  productiviteit: 'AI tools die je helpen efficienter te werken: notitie-apps, planning, automatisering en tijdmanagement.',
  marketing: 'AI voor e-mailmarketing, SEO, social media, content marketing en advertenties.',
  creatie: 'AI tools voor content creatie: schrijftools, image generators, video tools en design.',
  development: 'AI coding assistants, code generators, low-code tools en developer platforms.',
  business: 'AI tools voor ondernemers: administratie, klantenservice, sales en data-analyse.',
  technologie: 'AI tools voor security, privacy, cloud optimalisatie, DevOps en technische compliance.',
  'huis-tuin': 'Vergelijk energiecontracten, internetproviders, vakantieparken en andere praktische diensten.',
  persoonlijk: 'Vergelijk verzekeringen, hypotheken, mobiele abonnementen en financiële diensten voor consumenten.'
};

---
<BaseLayout title={`${labels[cat] || cat}: AI en software vergelijken | Dutch AI Tools`} description={descriptions[cat] || `Vergelijkingen voor ${cat}.`}>
 <div class="page-width">
  <header class="page-intro">
   <p class="eyebrow"><a href="/vergelijkingen-2026/">Alle keuzehulpen</a></p>
   <h1 class="mt-3">{cat === 'business' ? 'Bedrijfsvoering: wat wil je eenvoudiger maken?' : labels[cat] || cat}</h1>
   <p>{cat === 'business' ? 'Begin met één terugkerende taak. Kies hieronder een startpunt of zoek verder op onderwerp. Een extra tool is niet altijd nodig: kijk eerst wat je huidige software al kan.' : descriptions[cat]}</p>
  </header>
  {cat === 'business' && <section class="business-starts" aria-label="Start bij je taak">
   <div class="business-choices">
    <div>
     <h2>Gegevens overnemen tussen systemen</h2>
     <p>Kopieer je aanvragen van een formulier naar je administratie? Begin met de gids over zakelijke automatisering. Die helpt je letten op koppelingen, kosten, foutafhandeling en beheer.</p>
     <a href="/ai-tools-zakelijke-automatisering-2026/">Lees de gids over zakelijke automatisering</a>
    </div>
    <div>
     <h2>Offertes opstellen en versturen</h2>
     <p>Wil je vooral teksten voorbereiden, offertes laten accepteren of gegevens doorzetten? Noteer eerst wat je nodig hebt. Zoek hieronder op ‘offerte’ voor de bestaande gidsen; controleer functies en voorwaarden bij de aanbieder voordat je kiest.</p>
    </div>
   </div>
   <p class="business-method">Deze startpunten sluiten aan op de taak; ze zijn geen ranglijst. De automatiseringsgids gebruikt openbare documentatie, geen eigen praktijktest. Controleer per artikel de datum, bronnen en beperkingen.</p>
   <p class="business-method">Sommige links zijn partnerlinks. Als je via zo’n link iets afsluit, kunnen wij commissie ontvangen. <a href="/over/">Werkwijze en beperkingen</a></p>
  </section>}
  <ArticleSearch articles={articles} />
 </div>
</BaseLayout>

<style>
 .business-starts{padding-block:1.75rem;border-bottom:1px solid var(--line)}
 .business-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem;margin-bottom:1.5rem}
 .business-choices h2{font-size:1.3rem;line-height:1.3;font-weight:700}
 .business-choices p{margin-block:.6rem;color:var(--muted)}
 .business-starts a{color:var(--blue-dark);text-decoration:underline;text-underline-offset:3px}
 .business-choices a{display:inline-block;font-weight:700}
 .business-method{max-width:65rem;font-size:.95rem;color:var(--muted);margin-top:.7rem}
 @media(max-width:767px){.business-choices{grid-template-columns:minmax(0,1fr);gap:1.5rem}}
</style>
