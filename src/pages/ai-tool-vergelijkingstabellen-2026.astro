---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadRegistry, resolveAffiliateUrl, detectMerchant, canRenderAffiliate, merchantMatchesTool, resolveSafeDirectProviderUrl } from '../lib/affiliateRegistry.ts';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const registry = loadRegistry();
const SITE_ID = 'dutch-ai-tools';

// Category metadata
const categoryLabels: Record<string, string> = {
  productiviteit: 'Productiviteit',
  marketing: 'Marketing',
  creatie: 'Creatie',
  development: 'Development',
  business: 'Business',
  technologie: 'Technologie',
  'huis-tuin': 'Huis & Tuin',
  persoonlijk: 'Persoonlijk'
};

const categoryDescriptions: Record<string, string> = {
  productiviteit: 'AI tools voor efficiënter werken: planning, notities, automatisering en tijdmanagement.',
  marketing: 'AI voor SEO, content marketing, e-mailcampagnes, social media en leadgeneratie.',
  creatie: 'AI tools voor content creatie, design, afbeeldingen, video en audio generatie.',
  development: 'AI coding assistants, code generators, low-code platforms en developer tools.',
  business: 'AI voor administratie, CRM, klantenservice, sales en data-analyse.',
  technologie: 'AI tools voor security, privacy, cloud, DevOps en technische compliance.',
  'huis-tuin': 'Praktische vergelijkingen voor energie, internet, verzekeringen en huishoudelijke diensten.',
  persoonlijk: 'Vergelijkingen van financiële producten, verzekeringen en persoonlijke diensten.'
};

// Group articles by category and prepare top tools for tables
const categoryData = Object.keys(categoryLabels).map(cat => {
  const catArticles = allArticles
    .filter(a => a.data.category === cat)
    .sort((a, b) => (b.data.rating || 0) - (a.data.rating || 0));

  const count = catArticles.length;

  // Top 6 articles for table
  const topArticles = catArticles.slice(0, 6).map(article => {
    const data = article.data;
    let affiliateUrl: string | null = null;
    let affiliateMerchant: string | null = null;
    const featuredTool = data.featuredTool || (data.tools?.[0]?.name || 'Tool');

    if (data.affiliateLinks && Array.isArray(data.affiliateLinks) && data.affiliateLinks.length > 0) {
      const firstLink = data.affiliateLinks[0];
      const merchantId = detectMerchant(firstLink);
      const merchantMatches = !!merchantId && merchantMatchesTool(merchantId, featuredTool);
      if (merchantId && canRenderAffiliate(merchantId, SITE_ID) && merchantMatches) {
        affiliateUrl = resolveAffiliateUrl(merchantId, SITE_ID) || firstLink;
        affiliateMerchant = merchantId;
      } else if (!merchantId || merchantMatches) {
        affiliateUrl = resolveSafeDirectProviderUrl(firstLink);
      }
    }

    if (!affiliateUrl && data.tools && Array.isArray(data.tools)) {
      const topTool = data.tools[0];
      if (topTool?.affiliateLink) {
        const merchantId = detectMerchant(topTool.affiliateLink);
        const merchantMatches = !!merchantId && merchantMatchesTool(merchantId, topTool.name);
        if (merchantId && canRenderAffiliate(merchantId, SITE_ID) && merchantMatches) {
          affiliateUrl = resolveAffiliateUrl(merchantId, SITE_ID) || topTool.affiliateLink;
          affiliateMerchant = merchantId;
        } else if (!merchantId || merchantMatches) {
          affiliateUrl = resolveSafeDirectProviderUrl(topTool.affiliateLink);
        }
      }
    }

    return {
      title: data.title,
      slug: data.slug,
      rating: data.rating,
      priceRange: data.priceRange || 'Onbekend',
      description: data.description.length > 120 ? data.description.substring(0, 117) + '...' : data.description,
      featuredTool,
      affiliateUrl,
      affiliateMerchant
    };
  });

  return {
    cat,
    label: categoryLabels[cat],
    description: categoryDescriptions[cat],
    count,
    topArticles
  };
}).filter(c => c.count > 0)
  .sort((a, b) => b.count - a.count);
---

<BaseLayout title="Vergelijkingstabellen per werkgebied | Dutch AI Tools" description="Bestaande softwareselecties in tabelvorm. Lees de vergelijking voor de context bij prijzen en scores, en controleer de actuele voorwaarden bij de aanbieder.">
 <div class="page-width"><header class="page-intro"><h1>Vergelijkingstabellen</h1><p>Bestaande selecties uit het archief, met prijzen en redactionele scores uit de artikelen. Lees de volledige vergelijking voordat je kiest.</p><p><a class="text-leaf underline" href="/over/#scores">Wat betekenen de scores?</a></p></header>
 <nav class="index-links" aria-label="Werkgebieden">{categoryData.map(category=><a href={`#${category.cat}`}>{category.label}</a>)}</nav>
 {categoryData.map(({cat,label,description,count,topArticles})=><section class="article-section"><h2 id={cat} class="section-title">{label}</h2><p>{description}</p><p class="mt-4 text-sm text-muted md:hidden">Schuif de tabel opzij voor alle kolommen.</p><div class="data-table-wrap" tabindex="0" role="region" aria-label={`Vergelijkingen ${label}, horizontaal scrollbaar`}><table class="data-table"><thead><tr><th scope="col">Vergelijking</th><th scope="col">Score / 5</th><th scope="col">Prijsindicatie</th><th scope="col">Aanbieder</th></tr></thead><tbody>{topArticles.map(item=><tr><td><a href={`/${item.slug}/`}>{item.title}</a><p>{item.description}</p></td><td>{item.rating ?? 'Niet gescoord'}</td><td>{item.priceRange}</td><td>{item.affiliateUrl ? <a href={item.affiliateUrl} target="_blank" rel={item.affiliateMerchant ? 'noopener noreferrer sponsored nofollow' : 'noopener noreferrer nofollow'} data-affiliate-merchant={item.affiliateMerchant || undefined} data-affiliate-site={item.affiliateMerchant ? SITE_ID : undefined} class="button-secondary">{item.affiliateMerchant ? 'Partnerlink' : 'Naar aanbieder'}</a> : <span>Geen link</span>}</td></tr>)}</tbody></table></div><p><a class="text-leaf underline" href={`/categorie/${cat}/`}>Alle {count} keuzehulpen over {label.toLowerCase()}</a></p></section>)}
 <p class="py-5 text-muted">Bij een partnerlink kan Dutch AI Tools commissie ontvangen. <a class="text-leaf underline" href="/over/#partnerlinks">Lees over partnerlinks</a>.</p></div>
</BaseLayout>
