---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';


const articles = await getCollection('articles', ({ data }) => !data.draft);



// Group by category
const categoryGroups: Record<string, any[]> = {};
articles.forEach(article => {
  const cat = article.data.category;
  if (!categoryGroups[cat]) categoryGroups[cat] = [];
  categoryGroups[cat].push(article);
});

// Category labels
const categoryLabels: Record<string, string> = {
  productiviteit: 'Productiviteit',
  marketing: 'Marketing',
  creatie: 'Creatie',
  development: 'Development',
  business: 'Business',
  technologie: 'Technologie',
  'huis-tuin': 'Huis & Tuin',
  persoonlijk: 'Persoonlijk'
};

// Build table data for each category
const categoryTables = Object.entries(categoryGroups).map(([cat, arts]) => {
  // Take top 5 by rating
  const top = arts
    .filter(a => (a.data.rating ?? 0) >= 3.5)
    .sort((a, b) => (b.data.rating || 0) - (a.data.rating || 0))
    .slice(0, 5);
  
  return {
    cat,
    label: categoryLabels[cat] || cat,
    articles: top.map(a => ({
      title: a.data.title,
      slug: a.data.slug,
      rating: a.data.rating,
      priceRange: a.data.priceRange,
      description: a.data.description.substring(0, 120) + '...',
      affiliateLinks: a.data.affiliateLinks.slice(0, 2)
    }))
  };
});

// Build tool matrix from all articles
// Note: toolList is defined for potential future use, currently not rendered
---

<BaseLayout title="Overzicht per werkgebied | Dutch AI Tools" description="Een selectie van bestaande softwarevergelijkingen per werkgebied. Bekijk de prijsindicatie uit het artikel en lees de volledige vergelijking voor context.">
 <div class="page-width"><header class="page-intro"><h1>Overzicht per werkgebied</h1><p>Een selectie uit {articles.length} keuzehulpen. De prijsindicaties horen bij de artikeldatum; dit overzicht is geen actuele prijslijst.</p><p><a class="text-leaf underline" href="/vergelijkingen-2026/">Doorzoek alle keuzehulpen</a></p></header>
 <nav class="index-links" aria-label="Werkgebieden">{categoryTables.map(category=><a href={`#${category.cat}`}>{category.label}</a>)}</nav>
 {categoryTables.map(({cat,label,articles:selection})=><section class="article-section"><h2 id={cat} class="section-title">{label}</h2><p>{categoryGroups[cat].length} artikelen in dit werkgebied.</p><p class="mt-4 text-sm text-muted md:hidden">Schuif de tabel opzij voor alle kolommen.</p><div class="data-table-wrap" tabindex="0" role="region" aria-label={`Overzicht ${label}, horizontaal scrollbaar`}><table class="data-table"><thead><tr><th scope="col">Vergelijking</th><th scope="col">Prijsindicatie uit artikel</th></tr></thead><tbody>{selection.map(article=><tr><td><a href={`/${article.slug}/`}>{article.title}</a><p>{article.description}</p></td><td>{article.priceRange}</td></tr>)}</tbody></table></div><p><a class="text-leaf underline" href={`/categorie/${cat}/`}>Alle keuzehulpen over {label.toLowerCase()}</a></p></section>)}
 </div>
</BaseLayout>
