---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const coreCategories = ['productiviteit', 'marketing', 'creatie', 'development', 'business', 'technologie'];
const categoryLabels: Record<string, string> = {
  productiviteit: 'Productiviteit', marketing: 'Marketing', creatie: 'Beeld & creatie',
  development: 'Development', business: 'Bedrijfsvoering', technologie: 'Technologie'
};
const categoryTexts: Record<string, string> = {
  productiviteit: 'Van chatbots en notities tot planning en workflow-automatisering.',
  marketing: 'Tools voor research, SEO, campagnes, e-mail en social content.',
  creatie: 'Vergelijk schrijven, beeld, video, audio en design met AI.',
  development: 'Coding assistants, prototyping, testing en developer workflows.',
  business: 'AI voor teams, klantenservice, analyse en dagelijkse operatie.',
  technologie: 'Privacy, security, infrastructuur en technische AI-keuzes.'
};
const categoryMarks: Record<string, string> = {
  productiviteit: '01', marketing: '02', creatie: '03', development: '04', business: '05', technologie: '06'
};
const catCounts: Record<string, number> = {};
articles.forEach((article) => { catCounts[article.data.category] = (catCounts[article.data.category] || 0) + 1; });
const categories = coreCategories.filter((category) => catCounts[category]).map((category) => ({
  href: `/categorie/${category}/`,
  label: categoryLabels[category],
  text: categoryTexts[category],
  mark: categoryMarks[category],
  count: catCounts[category]
}));
const featured = articles.find((article) => article.data.slug === 'beste-ai-chatbots-2026') || articles[0];
const latest = articles.filter((article) => coreCategories.includes(article.data.category)).slice(0, 9);
const directComparisons = articles
  .filter((article) => article.data.slug.includes('-vs-') && coreCategories.includes(article.data.category))
  .sort((a, b) => b.data.rating - a.data.rating);
const routes = [
  { mark: 'TXT', title: 'Schrijven & analyseren', text: 'Kies tussen ChatGPT, Claude en Gemini op basis van je echte werk.', href: '/beste-ai-chatbots-2026/' },
  { mark: 'SRC', title: 'Research met bronnen', text: 'Vind tools die zoeken, samenvatten en hun bronnen zichtbaar maken.', href: '/categorie/productiviteit/' },
  { mark: 'DEV', title: 'Bouwen & automatiseren', text: 'Vergelijk coding assistants en tools voor herhaalbare workflows.', href: '/categorie/development/' }
];
---

<BaseLayout
  title="Dutch AI Tools — nuchtere keuzehulp voor AI in 2026"
  description="Kies een AI-tool op basis van je werk, budget en vereisten. Nederlandstalige vergelijkingen met duidelijke beperkingen, directe links en controleerbare bronnen."
>
  <section class="relative overflow-hidden border-b border-[#dfe5ec]">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_78%_24%,rgba(34,182,155,0.13),transparent_23rem)]"></div>
    <div class="relative mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 sm:py-20 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:px-8 lg:py-24">
      <div>
        <p class="eyebrow">Onafhankelijke keuzehulp voor AI</p>
        <h1 class="display-title mt-5 max-w-4xl">Kies wat werkt.<br /><span class="gradient-word">Niet wat schreeuwt.</span></h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted sm:text-xl">
          AI-tools veranderen sneller dan hun verkooppagina’s. Wij brengen de opties terug tot de vraag die telt: welke tool past bij jouw werk, grenzen en budget?
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a class="button-primary" href="/beste-ai-chatbots-2026/">Start met de chatbot-keuze <span class="ml-2" aria-hidden="true">→</span></a>
          <a class="button-secondary" href="/over/">Bekijk hoe we vergelijken</a>
        </div>
        <div class="mt-7 flex flex-wrap gap-x-6 gap-y-3">
          <span class="trust-pill">Bronnen bij de keuze</span>
          <span class="trust-pill">Direct naar de aanbieder</span>
          <span class="trust-pill">Affiliate links gemarkeerd</span>
        </div>
      </div>

      <aside class="premium-card relative p-5 sm:p-7">
        <div class="absolute -right-10 -top-10 h-32 w-32 rounded-full bg-[#2357df]/10 blur-3xl"></div>
        <div class="relative flex items-start justify-between gap-4">
          <div>
            <p class="eyebrow">Begin bij je taak</p>
            <h2 class="mt-2 text-2xl font-extrabold tracking-[-0.035em] text-ink">Drie snelle routes</h2>
          </div>
          <span class="rounded-full border border-[#cbd8f5] bg-[#eef3ff] px-3 py-1 text-xs font-extrabold text-leaf">2026</span>
        </div>
        <div class="relative mt-6 grid gap-3">
          {routes.map((route) => (
            <a class="group flex items-start gap-4 rounded-2xl border border-[#e2e8ef] bg-white p-4 transition hover:-translate-y-0.5 hover:border-[#b9c9ef] hover:shadow-soft" href={route.href}>
              <span class="tool-orb">{route.mark}</span>
              <span class="min-w-0 flex-1">
                <span class="flex items-center justify-between gap-3 font-extrabold text-ink"><span>{route.title}</span><span class="text-leaf transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
                <span class="mt-1 block text-sm leading-5 text-muted">{route.text}</span>
              </span>
            </a>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-[.72fr_1.28fr] lg:items-end">
      <div>
        <p class="eyebrow">Uitgelicht</p>
        <h2 class="section-title mt-3">Een shortlist die je kunt uitleggen.</h2>
      </div>
      <p class="max-w-2xl text-base leading-7 text-muted lg:justify-self-end">Geen winnaar zonder context. We laten zien waar een tool sterk in is, wanneer je beter iets anders kiest en welke informatie rechtstreeks van de aanbieder komt.</p>
    </div>
    {featured && (
      <a href={`/${featured.data.slug}/`} class="group mt-8 grid overflow-hidden rounded-[1.5rem] border border-[#d9e1ea] bg-[#111a24] text-white shadow-[0_24px_70px_rgba(17,26,36,.16)] lg:grid-cols-[1.25fr_.75fr]">
        <div class="p-6 sm:p-9">
          <div class="flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-[.15em] text-[#9fb8ff]"><span>Nieuwe hoofdvergelijking</span><span class="h-1 w-1 rounded-full bg-[#22b69b]"></span><span>{featured.data.readingTime}</span></div>
          <h3 class="mt-5 max-w-3xl text-3xl font-extrabold leading-tight tracking-[-.045em] sm:text-4xl">{featured.data.title}</h3>
          <p class="mt-4 max-w-2xl leading-7 text-[#b9c5d0]">{featured.data.description}</p>
          <span class="mt-7 inline-flex items-center gap-2 font-extrabold text-white">Bekijk de onderbouwde keuze <span class="transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
        </div>
        <div class="relative min-h-56 overflow-hidden border-t border-white/10 bg-[linear-gradient(145deg,#173da7,#2357df_52%,#22b69b)] p-7 lg:border-l lg:border-t-0">
          <div class="absolute -right-16 -top-12 h-56 w-56 rounded-full border-[40px] border-white/10"></div>
          <div class="relative flex h-full flex-col justify-end">
            <span class="text-xs font-bold uppercase tracking-[.18em] text-white/70">Onze keuze</span>
            <strong class="mt-2 text-3xl tracking-[-.04em]">{featured.data.featuredTool}</strong>
            <span class="mt-3 max-w-xs text-sm leading-6 text-white/80">Sterke allround start — met duidelijke alternatieven voor research, lange documenten en ecosysteemintegratie.</span>
          </div>
        </div>
      </a>
    )}
  </section>

  <section class="border-y border-[#dfe5ec] bg-[#f1f5fa]">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
      <div class="max-w-2xl">
        <p class="eyebrow">Verken per werkgebied</p>
        <h2 class="section-title mt-3">Van brede belofte naar concrete taak.</h2>
      </div>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {categories.map((category) => (
          <a class="group rounded-2xl border border-[#d9e1ea] bg-white p-5 transition hover:-translate-y-1 hover:shadow-soft" href={category.href}>
            <div class="flex items-center justify-between"><span class="text-xs font-extrabold tracking-[.15em] text-leaf">{category.mark}</span><span class="rounded-full bg-[#f1f5fa] px-2.5 py-1 text-xs font-bold text-muted">{category.count} gidsen</span></div>
            <h3 class="mt-8 text-xl font-extrabold tracking-[-.025em] text-ink">{category.label}</h3>
            <p class="mt-2 text-sm leading-6 text-muted">{category.text}</p>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-extrabold text-leaf">Verken <span class="transition group-hover:translate-x-1" aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8" id="laatste-vergelijkingen">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div><p class="eyebrow">Recent bijgewerkt</p><h2 class="section-title mt-3">Keuzehulpen voor echte werkdagen.</h2></div>
      <a class="text-sm font-extrabold text-leaf hover:text-[#173da7]" href="/vergelijkingen-2026/">Bekijk alles →</a>
    </div>
    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {latest.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-12 sm:px-6 sm:pb-20 lg:px-8">
    <div class="premium-card grid gap-8 p-6 sm:p-9 lg:grid-cols-[.8fr_1.2fr]">
      <div><p class="eyebrow">Direct vergelijken</p><h2 class="section-title mt-3">Twee tools. Eén beslissing.</h2><p class="mt-4 leading-7 text-muted">Voor als je shortlist al klein is, maar het verschil nog vaag voelt.</p></div>
      <div class="grid gap-3 sm:grid-cols-2">
        {directComparisons.slice(0, 6).map((article) => (
          <a href={`/${article.data.slug}/`} class="group flex items-center justify-between gap-3 rounded-xl border border-[#e0e6ed] bg-[#f8fafc] px-4 py-3 text-sm font-bold text-ink transition hover:border-[#b9c9ef] hover:bg-white">
            <span class="line-clamp-2">{article.data.title}</span><span class="text-leaf transition group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
