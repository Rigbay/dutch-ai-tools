---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';


const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const coreCategories = ['productiviteit', 'marketing', 'creatie', 'development', 'business', 'technologie'];
const categoryLabels: Record<string, string> = {
  productiviteit: 'Productiviteit', marketing: 'Marketing', creatie: 'Beeld & creatie',
  development: 'Development', business: 'Bedrijfsvoering', technologie: 'Technologie'
};
const categoryTexts: Record<string, string> = {
  productiviteit: 'Van chatbots en notities tot planning en workflow-automatisering.',
  marketing: 'Tools voor research, SEO, campagnes, e-mail en social content.',
  creatie: 'Vergelijk schrijven, beeld, video, audio en design met AI.',
  development: 'Coding assistants, prototyping, testing en developer workflows.',
  business: 'AI voor teams, klantenservice, analyse en dagelijkse operatie.',
  technologie: 'Privacy, security, infrastructuur en technische AI-keuzes.'
};
const categoryMarks: Record<string, string> = {
  productiviteit: '01', marketing: '02', creatie: '03', development: '04', business: '05', technologie: '06'
};
const catCounts: Record<string, number> = {};
articles.forEach((article) => { catCounts[article.data.category] = (catCounts[article.data.category] || 0) + 1; });
const categories = coreCategories.filter((category) => catCounts[category]).map((category) => ({
  href: `/categorie/${category}/`,
  label: categoryLabels[category],
  text: categoryTexts[category],
  mark: categoryMarks[category],
  count: catCounts[category]
}));
const featured = articles.find((article) => article.data.slug === 'beste-ai-chatbots-2026') || articles[0];
const latest = articles.filter((article) => coreCategories.includes(article.data.category)).slice(0, 5);
const directComparisons = articles
  .filter((article) => article.data.slug.includes('-vs-') && coreCategories.includes(article.data.category))
  .sort((a, b) => (b.data.rating ?? 0) - (a.data.rating ?? 0));
const routes = [
  { icon: 'writing', title: 'Schrijven & analyseren', text: 'Kies tussen ChatGPT, Claude en Gemini op basis van je echte werk.', href: '/beste-ai-chatbots-2026/' },
  { icon: 'research', title: 'Research met bronnen', text: 'Vind tools die zoeken, samenvatten en hun bronnen zichtbaar maken.', href: '/categorie/productiviteit/' },
  { icon: 'building', title: 'Werk automatiseren', text: 'Kies tussen Make, Zapier, n8n en Pipedream voor je terugkerende werk.', href: '/beste-ai-automation-tools-2026/' }
] as const;
---

<BaseLayout title="Dutch AI Tools — AI en software vergelijken" description="Nederlandstalige keuzehulpen voor AI en software. Vergelijk tools voor schrijven, research, automatisering en meer op toepassing, beperkingen en prijsmodel.">
 <div class="page-width">
  <section class="home-opening">
   <div><h1 class="display-title">Welke AI-tool past bij je werk?</h1><p>Vergelijk wat tools kunnen, wat ze kosten en waar je rekening mee moet houden. Begin met de taak waarvoor je software zoekt.</p><a class="mt-5 inline-block font-bold text-leaf underline underline-offset-4" href="/vergelijkingen-2026/">Zoek in alle keuzehulpen</a></div>
   <nav class="task-list" aria-label="Begin bij je taak">{routes.map(route => <a href={route.href}><strong>{route.title}</strong><span>{route.text}</span></a>)}</nav>
  </section>
  <section class="home-guide">
   {featured && <div class="lead-story"><p class="eyebrow">Chatbots vergelijken</p><h2><a href={`/${featured.data.slug}/`}>ChatGPT, Claude of Gemini?</a></h2><p>{featured.data.description}</p><a class="mt-5 inline-block font-bold text-leaf underline underline-offset-4" href={`/${featured.data.slug}/`}>Lees de chatbot-keuzehulp</a></div>}
   <nav class="subject-list" aria-label="Werkgebieden"><h2>Blader per werkgebied</h2><ul>{categories.map(category => <li><a href={category.href}><span>{category.label}</span><small>{category.count} gidsen</small></a></li>)}</ul></nav>
  </section>
  <section class="home-lower" id="laatste-vergelijkingen">
   <div><h2 class="section-title">Laatste keuzehulpen</h2><div class="article-list">{latest.map(article => <ArticleCard article={article} />)}</div><a class="mt-5 inline-block text-leaf font-bold underline" href="/vergelijkingen-2026/">Alle keuzehulpen bekijken</a></div>
   <aside class="reading-note"><h2>Een vergelijking is een beginpunt</h2><p>Prijzen en functies veranderen. Bekijk de datum en bronnen van een artikel, en probeer een tool met je eigen werk voordat je een abonnement kiest.</p><p>Sommige links zijn partnerlinks. Als je via zo’n link iets afsluit, kunnen wij commissie ontvangen.</p><p><a href="/over/">Lees hoe je deze site gebruikt</a></p></aside>
  </section>
  <section class="article-section"><h2 class="section-title">Tools naast elkaar</h2><div class="grid gap-x-10 md:grid-cols-2">{directComparisons.slice(0,4).map(article => <ArticleCard article={article} />)}</div><a class="mt-5 inline-block text-leaf font-bold underline" href="/vergelijk/">Meer directe vergelijkingen</a></section>
 </div>
</BaseLayout>
