---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);

// Get all comparison articles (those with "vs" in the slug or title)
const comparisonArticles = allArticles.filter(a => {
  const s = a.data?.slug || a.id || '';
  return s && (s.includes('-vs-') || s.includes('-versus-') || s.includes('vergelijking'));
});

// Cluster by category
const comparisonClusters: Record<string, { label: string; articles: any[] }> = {
  'chatbots-ai': {
    label: 'Chatbots & AI Assistants',
    articles: []
  },
  'creatie': {
    label: 'Creatie & Design',
    articles: []
  },
  'video-audio': {
    label: 'Video & Audio',
    articles: []
  },
  'development': {
    label: 'Development & Code',
    articles: []
  },
  'marketing': {
    label: 'Marketing & Sales',
    articles: []
  },
  'productiviteit': {
    label: 'Productiviteit & Werk',
    articles: []
  },
  'business-tools': {
    label: 'Business Tools',
    articles: []
  },
};

const clusterMap: Record<string, string> = {
  'chatgpt-vs-gemini-vs-claude-nederlands-2026': 'chatbots-ai',
  'perplexity-vs-chatgpt-vs-claude-2026': 'chatbots-ai',
  'claude-3-5-sonnet-vs-gpt-4o-vs-gemini-1-5-pro-2026': 'chatbots-ai',
  'midjourney-vs-dall-e-3-vs-stable-diffusion-2026': 'creatie',
  'canva-vs-adobe-express-vs-figma-ai-2026': 'creatie',
  'photoshop-ai-vs-affinity-photo-vs-luminar-neo-2026': 'creatie',
  'framer-ai-vs-webflow-vs-wix-studio-2026': 'creatie',
  'luma-vs-kling-vs-runway-2026': 'video-audio',
  'synthesia-vs-heygen-vs-colossyan-2026': 'video-audio',
  'elevenlabs-vs-murf-ai-vs-play-ht-2026': 'video-audio',
  'descript-vs-podcastle-vs-alitu-2026': 'video-audio',
  'claude-code-vs-cursor-vs-windsurf-2026': 'development',
  'github-copilot-vs-cursor-vs-codeium-2026': 'development',
  'bolt-new-vs-v0-dev-vs-lovable-2026': 'development',
  'jasper-vs-copy-ai-vs-writesonic-vs-rytr-2026': 'marketing',
  'surferseo-vs-clearscope-vs-marketmuse-2026': 'marketing',
  'klaviyo-vs-mailchimp-vs-brevo-2026': 'marketing',
  'grammarly-vs-prowritingaid-vs-languagetool-2026': 'marketing',
  'hubspot-vs-salesforce-vs-pipedrive-ai-crm-2026': 'marketing',
  'deepl-vs-google-translate-vs-chatgpt-2026': 'marketing',
  'miro-vs-figjam-vs-mural-2026': 'productiviteit',
  'notion-ai-vs-clickup-ai-vs-monday-ai-2026': 'productiviteit',
  'gemini-workspace-vs-copilot-365-vs-notion-ai-2026': 'productiviteit',
  'zapier-central-vs-make-ai-vs-relevance-ai-2026': 'productiviteit',
  'otter-ai-vs-fireflies-vs-fathom-2026': 'productiviteit',
  'gamma-vs-beautiful-ai-vs-tome-2026': 'productiviteit',
  'todoist-vs-ticktick-vs-things-2026': 'productiviteit',
  'obsidian-vs-notion-vs-roam-research-2026': 'productiviteit',
  'calendly-vs-cal-com-vs-doodle-2026': 'business-tools',
  'trello-vs-asana-vs-monday-2026': 'productiviteit',
  'slack-vs-teams-vs-discord-2026': 'productiviteit',
  'typeform-vs-jotform-vs-google-forms-2026': 'business-tools',
};

for (const article of comparisonArticles) {
  const slug = article.data?.slug || article.id || '';
  const clusterKey = (clusterMap[slug] || article.data?.category || 'productiviteit');
  if (comparisonClusters[clusterKey]) {
    comparisonClusters[clusterKey].articles.push(article);
  }
}

// Remove empty clusters
const activeClusters = Object.entries(comparisonClusters)
  .filter(([_, cluster]) => cluster.articles.length > 0)
  .sort((a, b) => b[1].articles.length - a[1].articles.length);

const totalComparisons = activeClusters.reduce((sum, [_, c]) => sum + c.articles.length, 0);
---

<BaseLayout
  title="AI Tools Vergelijken 2026: Vergelijkingspagina's per Categorie"
  description={`Vergelijk ${totalComparisons} AI tools in 2026. Diepgaande vergelijkingen met prijzen, scores en praktische aanbevelingen voor Nederlandse gebruikers.`}
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-serif font-semibold mb-3">AI Tools Vergelijken 2026</h1>
    <p class="text-lg text-muted mb-8">
      {totalComparisons} diepgaande AI tool vergelijkingen met prijzen, scores en concrete aanbevelingen.<br/>
      Kies de juiste AI tool door deze objectieve Nederlandstalige reviews naast elkaar te lezen.
    </p>

    {activeClusters.map(([key, cluster]) => (
      <section class="mb-10">
        <h2 class="text-2xl font-semibold mb-4 border-b pb-2">{cluster.label} ({cluster.articles.length})</h2>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {cluster.articles.sort((a, b) => ((b.data?.rating || 0) - (a.data?.rating || 0))).map(article => (
            <a href={`/${article.slug}/`} class="block rounded border border-[#e2e5f0] bg-paper p-4 shadow-sm hover:-translate-y-0.5 hover:shadow-soft transition">
              <div class="flex items-start gap-2">
                <span class="text-yellow-500 text-sm mt-0.5 shrink-0">⭐ {article.data?.rating || '—'}</span>
                <div class="min-w-0">
                  <p class="font-medium text-sm leading-snug line-clamp-2">{article.data?.title || article.slug}</p>
                  <p class="text-xs text-muted mt-1">{article.data?.priceRange || ''}</p>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}

    <div class="mt-10 p-6 bg-[#f8f5f0] rounded">
      <h3 class="font-semibold mb-2">Ook per categorie bekijken</h3>
      <p class="text-sm text-muted mb-4">
        Alle {allArticles.length} artikelen inclusief individuele tool reviews per categorie:
      </p>
      <div class="flex flex-wrap gap-2">
        {['productiviteit', 'marketing', 'creatie', 'development', 'business', 'technologie'].map(cat => (
          <a href={`/categorie/${cat}/`} class="px-3 py-1.5 bg-white border border-[#e2e5f0] rounded text-sm hover:bg-[#f0f4ff] transition">
            {cat.charAt(0).toUpperCase() + cat.slice(1)} →
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
