---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);

const comparisonArticles = allArticles.filter(a => {
  const s = a.data?.slug || a.id || '';
  return s && (s.includes('-vs-') || s.includes('-versus-'));
});

type Cluster = { label: string; articles: any[] };
const clusters: Record<string, Cluster> = {
  'chatbots-ai': { label: 'Chatbots & AI Assistants', articles: [] },
  'creatie': { label: 'Creatie & Design', articles: [] },
  'video-audio': { label: 'Video & Audio', articles: [] },
  'development': { label: 'Development & Code', articles: [] },
  'marketing': { label: 'Marketing & Sales', articles: [] },
  'productiviteit': { label: 'Productiviteit & Werk', articles: [] },
  'business-tools': { label: 'Business Tools', articles: [] },
};

const clusterMap: Record<string, string> = {
  'chatgpt-vs-gemini-vs-claude-nederlands-2026': 'chatbots-ai',
  'perplexity-vs-chatgpt-vs-claude-2026': 'chatbots-ai',
  'claude-3-5-sonnet-vs-gpt-4o-vs-gemini-1-5-pro-2026': 'chatbots-ai',
  'midjourney-vs-dall-e-3-vs-stable-diffusion-2026': 'creatie',
  'canva-vs-adobe-express-vs-figma-ai-2026': 'creatie',
  'photoshop-ai-vs-affinity-photo-vs-luminar-neo-2026': 'creatie',
  'figma-vs-sketch-vs-adobe-xd-2026': 'creatie',
  'framer-ai-vs-webflow-vs-wix-studio-2026': 'creatie',
  'luma-vs-kling-vs-runway-2026': 'video-audio',
  'synthesia-vs-heygen-vs-colossyan-2026': 'video-audio',
  'elevenlabs-vs-murf-ai-vs-play-ht-2026': 'video-audio',
  'descript-vs-podcastle-vs-alitu-2026': 'video-audio',
  'claude-code-vs-cursor-vs-windsurf-2026': 'development',
  'github-copilot-vs-cursor-vs-codeium-2026': 'development',
  'bolt-new-vs-v0-dev-vs-lovable-2026': 'development',
  'jasper-vs-copy-ai-vs-writesonic-vs-rytr-2026': 'marketing',
  'hubspot-vs-salesforce-vs-pipedrive-ai-crm-2026': 'marketing',
  'klaviyo-vs-mailchimp-vs-brevo-2026': 'marketing',
  'otter-ai-vs-fireflies-vs-fathom-2026': 'productiviteit',
  'slack-vs-teams-vs-discord-2026': 'productiviteit',
  'zoom-vs-google-meet-vs-teams-2026': 'productiviteit',
  'calendly-vs-cal-com-vs-doodle-2026': 'productiviteit',
  'todoist-vs-ticktick-vs-things-2026': 'productiviteit',
  'trello-vs-asana-vs-monday-2026': 'productiviteit',
  'notion-ai-vs-clickup-ai-vs-monday-ai-2026': 'business-tools',
  'obsidian-vs-notion-vs-roam-research-2026': 'business-tools',
};

for (const article of comparisonArticles) {
  const cluster = clusterMap[article.data.slug] || 'business-tools';
  clusters[cluster].articles.push(article);
}
---

<BaseLayout
  title="Alle AI Tool Vergelijkingen 2026"
  description="Complete verzameling van nuchtere AI-tool vergelijkingen op één plek: chatbots, creatie, development, marketing, productiviteit en meer."
>
  <section class="border-b border-[#e8eced] bg-linen">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
      <p class="text-sm font-bold uppercase tracking-[0.16em] text-leaf">Vergelijkingen</p>
      <h1 class="mt-3 max-w-4xl font-serif text-4xl font-semibold leading-tight text-ink sm:text-5xl">
        Alle AI-tool vergelijkingen op één plek.
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-muted">
        Kies eerst het type, daarna het winnende gereedschap. Elke vergelijking legt verschil, prijs, gebruik en verborgen nadelen bloot in eenvoudig Nederlands.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid gap-10">
      {
        Object.entries(clusters)
          .filter(([, cluster]) => cluster.articles.length > 0)
          .map(([key, cluster]) => (
            <div>
              <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <p class="text-sm font-bold uppercase tracking-[0.16em] text-muted">{cluster.label}</p>
                  <h2 class="font-serif text-2xl font-semibold text-ink">{cluster.label}</h2>
                </div>
              </div>
              <div class="mt-5 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                {cluster.articles.map(a => (
                  <article class="flex h-full flex-col rounded border border-[#e6ded2] bg-paper p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-soft">
                    <div class="flex items-center justify-between gap-3 text-xs font-bold uppercase tracking-[0.14em] text-muted">
                      <span>Vergelijking</span>
                      <span>{a.data.date?.toString().slice(0, 4) || '2026'}</span>
                    </div>
                    <h3 class="mt-4 font-serif text-xl font-semibold leading-tight text-ink">
                      <a href={`/${a.data.slug}/`} class="hover:text-leaf">{a.data.title} </a>
                    </h3>
                    <p class="mt-3 text-sm leading-6 text-muted">{a.data.description}</p>
                    <a href={`/${a.data.slug}/`} class="mt-5 inline-flex w-fit rounded bg-leaf px-4 py-2 text-sm font-bold text-white transition hover:bg-[#1f514b]">Lees vergelijking</a>
                  </article>
                ))}
              </div>
            </div>
          ))
      }
    </div>
  </section>
</BaseLayout>
